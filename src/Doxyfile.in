# Основные настройки проекта
PROJECT_NAME           = "S21 Containers Implementation"
PROJECT_BRIEF          = "Реализация контейнеров"
PROJECT_NUMBER         = 2.0
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = Russian
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES

# Кодировки
DOXYFILE_ENCODING      = UTF-8
INPUT_ENCODING         = UTF-8

# Генерация выходных форматов
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = YES

# Настройки извлечения документации
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_LOCAL_METHODS  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

# Настройки исходного кода
INPUT                  = . include
FILE_PATTERNS          = *.hpp *.h *.tpp
RECURSIVE              = YES
EXCLUDE                = build/ tests/
EXCLUDE_SYMLINKS       = NO
EXCLUDE_PATTERNS       = */build/* */tests/*
EXCLUDE_SYMBOLS        = 

# Настройки русского языка
ALIASES                = "russian=\par Язык:\n" \
                         "note=\par Примечание:\n" \
                         "return=\par Возвращает:\n" \
                         "param=\par Параметры:\n"

# Настройки HTML вывода
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
ENUM_VALUES_PER_LINE   = 4
TOC_INCLUDE_HEADINGS   = 5

# Поиск и индексация
SEARCHENGINE           = YES
SERVER_BASED_SEARCH    = YES

# Графики и диаграммы
HAVE_DOT               = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_GRAPH_MAX_NODES    = 100

# Опции для лучшего отображения кода
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

# Настройки для C++
OPTIMIZE_OUTPUT_FOR_C  = NO
BUILTIN_STL_SUPPORT    = YES
CPP_CLI_SUPPORT        = NO
SIP_SUPPORT            = NO
IDL_PROPERTY_SUPPORT   = YES

PREDEFINED             = "russian="

# Игнорировать предупреждения
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES

# Максимальное количество предупреждений
MAX_DOT_GRAPH_DEPTH    = 2
DOT_MULTI_TARGETS      = YES

# Настройки для лучшего отображения классов
SHOW_GROUPED_MEMB_INC  = YES
SHOW_USED_FILES        = YES
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES

# Настройки сортировки
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES
SORT_MEMBERS_CTORS_1ST = YES
SORT_GROUP_NAMES       = YES